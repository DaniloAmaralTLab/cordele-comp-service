// Prisma schema for comp-service (cordele).
// Schema-per-tenant via a dynamic PrismaClient per schema (not the multiSchema preview feature).
// Each tenant schema (emp_<slug>) is isolated — no cross-tenant query is reachable.
// PrismaEmpresaService creates one PrismaClient per schema, cached by slug.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["metrics", "tracing"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  output          = "../src/infrastructure/prisma-client"
}

// =============================================================================
// Composition models
// Tenant schema: emp_<slug>. One PrismaClient per schema.
// =============================================================================

/// Editorial identity of a project.
/// One row per project; materialized lazily.
model Metadados {
  id           String   @id @default(uuid()) @db.Uuid
  projetoId    String   @unique @map("projeto_id") @db.Uuid
  titulo       String
  autor        String
  isbn         String?
  idioma       String   @default("pt")
  categoria    String?
  capaUrl      String?  @map("capa_url")
  editoraNome  String?  @map("editora_nome")
  /// false = lazy-default (cover uploaded but no PUT /metadados yet); true = metadata has been explicitly saved.
  materialized Boolean  @default(false)
  atualizadoEm DateTime @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  @@map("metadados")
}

/// Presentation parameters of a project.
/// One row per project; materialized lazily. Parent of LayoutOverride.
model ConfiguracaoLayout {
  id                 String           @id @default(uuid()) @db.Uuid
  projetoId          String           @unique @map("projeto_id") @db.Uuid
  fonteCorpoFamilia  String           @default("serif") @map("fonte_corpo_familia")
  fonteCorpoTamanho  Int              @default(12) @map("fonte_corpo_tamanho")
  espacamentoLinha   Decimal          @default(1.5) @map("espacamento_linha") @db.Decimal(3, 2)
  margemLateral      Int              @default(20) @map("margem_lateral")
  h1Tamanho          Int              @default(28) @map("h1_tamanho")
  h2Tamanho          Int              @default(22) @map("h2_tamanho")
  h3Tamanho          Int              @default(18) @map("h3_tamanho")
  atualizadoEm       DateTime         @default(now()) @map("atualizado_em") @db.Timestamptz(6)
  overrides          LayoutOverride[]

  @@map("configuracao_layout")
}

/// Page/image presentation overrides.
/// References nodes of the imported manuscript (read-only). MVP: tipo=imagem only.
model LayoutOverride {
  id                   String             @id @default(uuid()) @db.Uuid
  configuracaoLayoutId String             @map("configuracao_layout_id") @db.Uuid
  referenciaNo         String             @map("referencia_no")
  tipo                 String
  alinhamento          String?
  ordem                Int                @default(0)
  configuracaoLayout   ConfiguracaoLayout @relation(fields: [configuracaoLayoutId], references: [id], onDelete: Cascade)

  @@unique([configuracaoLayoutId, referenciaNo])
  @@index([configuracaoLayoutId, ordem])
  @@map("layout_override")
}
